From 0fadade0c1fcf17b19c1cf4c06bdd46c8f94211b Mon Sep 17 00:00:00 2001
From: NelloKudo <marshnelloosu@gmail.com>
Date: Mon, 7 Sep 2026 18:57:42 +0200
Subject: [PATCH] winepipewire.drv: Use WINE_AUDIO_QUANTUM, keeping
 WINE_PIPEWIRE_QUANTUM as a fallback.
---

diff --git a/dlls/winepipewire.drv/pipewire.c b/dlls/winepipewire.drv/pipewire.c
index ff2a8ef5b3b..c17ec3202c1 100644
--- a/dlls/winepipewire.drv/pipewire.c
+++ b/dlls/winepipewire.drv/pipewire.c
@@ -994,16 +994,23 @@ static void add_default_device(struct list *list, EndpointFormFactor form, const
 
 static uint32_t quantum_override(void)
 {
-    const char *env = getenv("WINE_PIPEWIRE_QUANTUM");
+    const char *name = "WINE_AUDIO_QUANTUM";
+    const char *env = getenv(name);
     unsigned long val;
 
+    if (!env || !*env)
+    {
+        name = "WINE_PIPEWIRE_QUANTUM";
+        env = getenv(name);
+    }
+
     if (!env || !*env)
         return 0;
 
     val = strtoul(env, NULL, 10);
     if (val < 16 || val > 8192)
     {
-        WARN("Ignoring WINE_PIPEWIRE_QUANTUM=%s, expected 16-8192 frames.\n", env);
+        WARN("Ignoring %s=%s, expected 16-8192 frames.\n", name, env);
         return 0;
     }
     return val;
