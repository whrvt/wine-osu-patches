From 3930bd02cadbea7c9c111812bdb27afc269d1679 Mon Sep 17 00:00:00 2001
From: M0n7y5 <17201053+M0n7y5@users.noreply.github.com>
Date: Sun, 26 Jul 2026 18:17:40 +0200
Subject: [PATCH] winepipewire.drv: Record how far the process callback got.

A silent death inside the callback left nothing behind to say which stream was
being serviced or how far it had got, and under RT_PROCESS the callback runs
on a foreign thread whose stack may be the only evidence and may not survive.

Publish a breadcrumb into the stream: a per-stream callback count and one of
three phases, written at entry, after the buffer is validated, and after it is
queued back.  Zero means the callback has never run for this stream.  The
driver never reads it; it exists to be recovered from a core file.

These are relaxed stores, so the value is a hint and not a happens-before
witness: a phase can be published earlier or later than the code it nominally
brackets.  Release ordering would fix that and is deliberately not used, since
the point is to cost nothing on the callback's hot path.

Nothing is logged or unwound at fault time and no signal is caught.  Wine
installs its own SIGSEGV, SIGBUS and SIGILL handlers to synthesise SEH
(dlls/ntdll/unix/signal_x86_64.c:3187, signal_i386.c:2471), and a unixlib
taking those over would break exception dispatch for the whole process.
External coredumps stay the mechanism; this only makes the pre-fault state
legible in one.
---
 dlls/winepipewire.drv/pipewire.c | 22 ++++++++++++++++++++++
 1 file changed, 22 insertions(+)

diff --git a/dlls/winepipewire.drv/pipewire.c b/dlls/winepipewire.drv/pipewire.c
index 6c8890dcce3..7c18b5f10f5 100644
--- a/dlls/winepipewire.drv/pipewire.c
+++ b/dlls/winepipewire.drv/pipewire.c
@@ -188,6 +188,8 @@ struct pipewire_stream
     INT64 clock_lastpos, clock_written;
     /* atomic: process callback relaxed-increments, timer/control relaxed-load */
     UINT32 underrun_count, overrun_count, bad_buffer_count;
+    UINT32 cb_seq;        /* callback-private: callbacks entered */
+    UINT32 cb_mark;       /* diagnostic breadcrumb, never read by the driver */
     BOOL underrun_logged, overrun_logged, bad_buffer_logged;
 
     struct list packet_free_head;
@@ -335,6 +337,21 @@ static WCHAR *utf8_to_wstr(const char *s)
     return w;
 }
 
+/* Post-mortem breadcrumb.  The process callback publishes how far it got into
+ * stream->cb_mark, which the driver never reads; it exists to be recovered
+ * from a core file.  Zero means the callback has never run for this stream,
+ * otherwise the low bits give the phase and the rest a callback count.
+ *
+ * The stores are relaxed, so this is a HINT and not a happens-before witness:
+ * a mark can be published earlier or later than the code it brackets.
+ * Release ordering would fix that and is not worth paying for on the hot
+ * path.  Read the value as "roughly here", not as proof. */
+#define CB_ENTER 1  /* in the callback, buffer not yet validated */
+#define CB_BODY  2  /* buffer validated, moving audio */
+#define CB_DONE  3  /* buffer queued back, callback returning */
+#define CB_MARK(s, ph) \
+    __atomic_store_n(&(s)->cb_mark, ((s)->cb_seq << 2) | (ph), __ATOMIC_RELAXED)
+
 /* Render dispatch mode, read from the environment once per process.  With
  * PW_STREAM_FLAG_RT_PROCESS the process callback runs on PipeWire's realtime
  * data thread rather than the thread loop.  What that is worth in latency is
@@ -1819,6 +1836,9 @@ static void on_stream_process(void *data)
     struct spa_buffer *buf;
     struct spa_data *d;
 
+    stream->cb_seq++;
+    CB_MARK(stream, CB_ENTER);
+
     if (!(b = pw_stream_dequeue_buffer(stream->pw)))
         return;
     buf = b->buffer;
@@ -1837,6 +1857,7 @@ static void on_stream_process(void *data)
         pw_stream_queue_buffer(stream->pw, b);
         return;
     }
+    CB_MARK(stream, CB_BODY);
 
     if (stream->dataflow == eRender)
     {
@@ -1937,6 +1958,7 @@ static void on_stream_process(void *data)
     }
 
     pw_stream_queue_buffer(stream->pw, b);
+    CB_MARK(stream, CB_DONE);
 }
 
 static const struct pw_stream_events stream_events = {
-- 
2.56.0

