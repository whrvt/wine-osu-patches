     struct central_directory_end end = {0};
+    struct zip_part **parts = NULL;
     ULARGE_INTEGER end_dir_start;
-    IOpcPart **parts = NULL;
     size_t parts_count = 0;
     LARGE_INTEGER off;
     HRESULT hr;
