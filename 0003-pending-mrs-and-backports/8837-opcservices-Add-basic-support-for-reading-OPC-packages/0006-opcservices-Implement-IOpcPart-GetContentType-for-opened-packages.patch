+        goto failed;
+    }
+    if (FAILED(hr = compress_read_content_types(stream, &content_types, &type_defaults, &type_overrides)))
+        goto failed;
+    hr = zip_parts_set_content_types(&type_defaults, &type_overrides, *parts, *parts_len);
+    rb_destroy(&type_defaults, content_type_entry_destroy, NULL);
+    rb_destroy(&type_overrides, content_type_entry_destroy, NULL);
+    if (SUCCEEDED(hr))
+        return S_OK;
 failed:
     for (i = 0; i < *parts_len; i++)
-        IOpcPart_Release((*parts)[i]);
+        IOpcPart_Release(&(*parts)[i]->IOpcPart_iface);
     free(*parts);
     *parts = NULL;
     *parts_len = 0;
@@ -1064,8 +1267,8 @@ failed:
 HRESULT compress_open_archive(IOpcFactory *factory, IStream *stream, IOpcPartSet **part_set)
