 dlls/opengl32/wgl.c          | 75 +++++++++++++++++++++++++++++++
 dlls/win32u/tests/d3dkmt.c   |  7 ++-
 include/wine/opengl_driver.h |  2 +
 8 files changed, 117 insertions(+), 93 deletions(-)

