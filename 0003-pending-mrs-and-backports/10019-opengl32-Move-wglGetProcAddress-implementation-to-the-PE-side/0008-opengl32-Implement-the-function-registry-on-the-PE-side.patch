+struct function_entry
+{
+    const char *name;
+    void *function;
+    enum opengl_extension supported[4];
+};
+
+static int function_entry_cmp( const void *a, const void *b )
+{
+    const struct function_entry *entry_a = a, *entry_b = b;
+    return strcmp( entry_a->name, entry_b->name );
 };
+
+static BOOL is_function_supported( const struct function_entry *entry, const struct opengl_client_context *ctx )
+{
+    for (const enum opengl_extension *ext = entry->supported; *ext != GL_EXTENSION_COUNT; ext++)
+    {
+         if (*ext < GL_EXTENSION_COUNT && ctx->extensions[*ext]) return TRUE;
+         if (*ext > GL_EXTENSION_COUNT && ctx->major_version > HIWORD(*ext)) return TRUE;
+         if (*ext > GL_EXTENSION_COUNT && ctx->major_version == HIWORD(*ext) && ctx->minor_version >= LOWORD(*ext)) return TRUE;
+    }
+    return FALSE;
+}
