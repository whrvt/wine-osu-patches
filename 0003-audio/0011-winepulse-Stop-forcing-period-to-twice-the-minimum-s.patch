From 01d715587fd448ba00df38174deae341c299ac7a Mon Sep 17 00:00:00 2001
From: NelloKudo <marshnelloosu@gmail.com>
Date: Sun, 8 Mar 2026 15:17:41 +0100
Subject: [PATCH 11/12] winepulse: Stop forcing period to twice the minimum
 size.

Since pipewire-1.6, minimum quant value has been increased to 256: no need to multiply it manually anymore.

https://gitlab.freedesktop.org/pipewire/pipewire/-/commit/7bd65cfe9385b4e005b7f5a85c9f1bdfa8a7b6d6
---
 dlls/winepulse.drv/pulse.c | 7 ++-----
 1 file changed, 2 insertions(+), 5 deletions(-)

diff --git a/dlls/winepulse.drv/pulse.c b/dlls/winepulse.drv/pulse.c
index a6d521a8e7b..998ba345a31 100644
--- a/dlls/winepulse.drv/pulse.c
+++ b/dlls/winepulse.drv/pulse.c
@@ -930,7 +930,6 @@ static void pulse_probe_settings(int render, const char *pulse_name, WAVEFORMATE
 
     if (length) {
         REFERENCE_TIME period_to_set = pa_bytes_to_usec(10 * length, &ss);
-        int multiplier = 2; // set 2x actual minimum unless custom period was specified
         static int periodval = -1;
         if (periodval == -1) {
             const char* penv = getenv("STAGING_AUDIO_PERIOD");
@@ -940,14 +939,12 @@ static void pulse_probe_settings(int render, const char *pulse_name, WAVEFORMATE
             }
         }
 
-        if (periodval > 0) {
+        if (periodval > 0)
             period_to_set = periodval;
-            multiplier = 1;
-        }
 
         /* overwrite default with minimum (for playback devices) */
         *min_period = find_closest_to_next_integer(period_to_set, ss.rate, 10000000);
-        *def_period = find_closest_to_next_integer(*min_period * multiplier, ss.rate, 10000000);
+        *def_period = find_closest_to_next_integer(*min_period, ss.rate, 10000000);
     }
 
     wfx->wFormatTag = WAVE_FORMAT_EXTENSIBLE;
-- 
