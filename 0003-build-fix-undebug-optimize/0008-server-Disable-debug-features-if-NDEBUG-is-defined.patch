From 60850a35e41e36948c976cdb58e79632897ab20c Mon Sep 17 00:00:00 2001
From: William Horvath <william@horvath.blog>
Date: Mon, 30 Dec 2024 02:14:28 -0800
Subject: [PATCH 08/14] server: Disable debug features if NDEBUG is defined.

Co-authored-by: Torge Matthies <openglfreak@googlemail.com>
---
 server/mapping.c |  4 ++++
 server/object.c  | 11 ++++++++---
 server/object.h  |  4 ++++
 3 files changed, 16 insertions(+), 3 deletions(-)

diff --git a/server/mapping.c b/server/mapping.c
index f9a80bc6cf9..6258cf75288 100644
--- a/server/mapping.c
+++ b/server/mapping.c
@@ -1532,7 +1532,9 @@ volatile void *alloc_shared_object( mem_size_t shm_size )
     SHARED_WRITE_BEGIN( &object->obj.shm, object_shm_t )
     {
         /* mark the object data as uninitialized */
+#ifndef NDEBUG
         mark_block_uninitialized( (void *)shared, shm_size );
+#endif
         CONTAINING_RECORD( shared, shared_object_t, shm )->id = ++session.last_object_id;
     }
     SHARED_WRITE_END;
@@ -1547,7 +1549,9 @@ void free_shared_object( volatile void *object_shm )
 
     SHARED_WRITE_BEGIN( &object->obj.shm, object_shm_t )
     {
+#ifndef NDEBUG
         mark_block_noaccess( (void *)shared, shm_size );
+#endif
         CONTAINING_RECORD( shared, shared_object_t, shm )->id = 0;
     }
     SHARED_WRITE_END;
diff --git a/server/object.c b/server/object.c
index a4cbd06f56d..0ea9a53bc21 100644
--- a/server/object.c
+++ b/server/object.c
@@ -186,8 +186,6 @@ void close_objects(void)
     dump_objects();  /* dump any remaining objects */
 }
 
-#endif  /* DEBUG_OBJECTS */
-
 /*****************************************************************/
 
 /* mark a block of memory as not accessible for debugging purposes */
@@ -217,11 +215,18 @@ void mark_block_uninitialized( void *ptr, size_t size )
 #endif
 }
 
+#endif  /* DEBUG_OBJECTS */
+
 /* malloc replacement */
 void *mem_alloc( size_t size )
 {
     void *ptr = malloc( size );
-    if (ptr) mark_block_uninitialized( ptr, size );
+    if (ptr)
+#ifndef NDEBUG
+        mark_block_uninitialized( ptr, size );
+#else
+0;
+#endif
     else set_error( STATUS_NO_MEMORY );
     return ptr;
 }
diff --git a/server/object.h b/server/object.h
index dc15da64518..99832ff3077 100644
--- a/server/object.h
+++ b/server/object.h
@@ -26,7 +26,9 @@
 #include "wine/server_protocol.h"
 #include "wine/list.h"
 
+#ifndef NDEBUG
 #define DEBUG_OBJECTS
+#endif
 
 /* kernel objects */
 
@@ -141,8 +143,10 @@ struct wait_queue_entry
     struct thread_wait *wait;
 };
 
+#ifndef NDEBUG
 extern void mark_block_noaccess( void *ptr, size_t size );
 extern void mark_block_uninitialized( void *ptr, size_t size );
+#endif
 extern void *mem_alloc( size_t size ) __WINE_ALLOC_SIZE(1) __WINE_DEALLOC(free) __WINE_MALLOC;
 extern void *memdup( const void *data, size_t len ) __WINE_ALLOC_SIZE(2) __WINE_DEALLOC(free);
 extern void *alloc_object( const struct object_ops *ops );
-- 
2.54.0

