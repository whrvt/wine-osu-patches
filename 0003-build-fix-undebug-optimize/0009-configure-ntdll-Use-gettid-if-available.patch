From 075c49a1d5e6605b42a4db8f65b84d555d54e30e Mon Sep 17 00:00:00 2001
From: William Horvath <william@horvath.blog>
Date: Sun, 29 Dec 2024 23:23:41 -0800
Subject: [PATCH 014/121] configure, ntdll: Use gettid() if available.

---
 configure.ac             | 1 +
 dlls/ntdll/unix/server.c | 2 ++
 2 files changed, 3 insertions(+)

diff --git a/configure.ac b/configure.ac
index ae655983934..fd4a84eaf35 100644
--- a/configure.ac
+++ b/configure.ac
@@ -2116,6 +2116,7 @@ AC_CHECK_FUNCS(\
 	getauxval \
 	getifaddrs \
 	getrandom \
+ 	gettid \
 	kqueue \
 	memfd_create \
 	pipe2 \
diff --git a/dlls/ntdll/unix/server.c b/dlls/ntdll/unix/server.c
index d0f6a0947b3..bf8376c03b4 100644
--- a/dlls/ntdll/unix/server.c
+++ b/dlls/ntdll/unix/server.c
@@ -1572,6 +1572,8 @@ static int get_unix_tid(void)
     int ret = -1;
 #ifdef HAVE_PTHREAD_GETTHREADID_NP
     ret = pthread_getthreadid_np();
+#elif defined(HAVE_GETTID)
+    ret = gettid();
 #elif defined(linux)
     ret = syscall( __NR_gettid );
 #elif defined(__sun)
-- 
2.54.0

