From 20d019c5d454aab5de666c3b3703f0966079b82b Mon Sep 17 00:00:00 2001
From: William Horvath <william@horvath.blog>
Date: Sun, 29 Dec 2024 23:23:41 -0800
Subject: [PATCH] configure, ntdll: Use gettid() if available.

---
 configure.ac             | 1 +
 dlls/ntdll/unix/server.c | 2 ++
 2 files changed, 3 insertions(+)

diff --git a/configure.ac b/configure.ac
index 0e7bdc99eb3..b0c6034851e 100644
--- a/configure.ac
+++ b/configure.ac
@@ -2100,6 +2100,7 @@ AC_CHECK_FUNCS(\
 	getauxval \
 	getifaddrs \
 	getrandom \
+ 	gettid \
 	kqueue \
 	memfd_create \
 	pipe2 \
diff --git a/dlls/ntdll/unix/server.c b/dlls/ntdll/unix/server.c
index 7c948a05750..0d5aa450e44 100644
--- a/dlls/ntdll/unix/server.c
+++ b/dlls/ntdll/unix/server.c
@@ -1574,6 +1574,8 @@ static int get_unix_tid(void)
     int ret = -1;
 #ifdef HAVE_PTHREAD_GETTHREADID_NP
     ret = pthread_getthreadid_np();
+#elif defined(HAVE_GETTID)
+    ret = gettid();
 #elif defined(linux)
     ret = syscall( __NR_gettid );
 #elif defined(__sun)
-- 
2.56.0

