From 4014655247ea28a7762ee85c6022303ac79410d2 Mon Sep 17 00:00:00 2001
From: William Horvath <william@horvath.blog>
Date: Sun, 29 Dec 2024 23:23:41 -0800
Subject: [PATCH] configure, ntdll: Use gettid() if available.

---
 configure.ac             | 1 +
 dlls/ntdll/unix/server.c | 2 ++
 2 files changed, 3 insertions(+)

diff --git a/configure.ac b/configure.ac
index 14668d58a7d..a6642998027 100644
--- a/configure.ac
+++ b/configure.ac
@@ -2108,6 +2108,7 @@ AC_CHECK_FUNCS(\
 	getauxval \
 	getifaddrs \
 	getrandom \
+ 	gettid \
 	kqueue \
 	memfd_create \
 	pipe2 \
diff --git a/dlls/ntdll/unix/server.c b/dlls/ntdll/unix/server.c
index e67bd71da38..026c7d0dcf9 100644
--- a/dlls/ntdll/unix/server.c
+++ b/dlls/ntdll/unix/server.c
@@ -1574,6 +1574,8 @@ static int get_unix_tid(void)
     int ret = -1;
 #ifdef HAVE_PTHREAD_GETTHREADID_NP
     ret = pthread_getthreadid_np();
+#elif defined(HAVE_GETTID)
+    ret = gettid();
 #elif defined(linux)
     ret = syscall( __NR_gettid );
 #elif defined(__sun)
-- 
2.56.0

