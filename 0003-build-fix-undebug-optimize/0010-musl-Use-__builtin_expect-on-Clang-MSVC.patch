From 743ceddc5f36024c07d68007a5a270185a8ce4d9 Mon Sep 17 00:00:00 2001
From: William Horvath <william@horvath.blog>
Date: Wed, 8 Jan 2025 22:33:17 -0800
Subject: [PATCH 015/121] musl: Use __builtin_expect on Clang MSVC.

---
 libs/musl/src/internal/libm.h | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/libs/musl/src/internal/libm.h b/libs/musl/src/internal/libm.h
index d49cc478bd3..0bc53b32dda 100644
--- a/libs/musl/src/internal/libm.h
+++ b/libs/musl/src/internal/libm.h
@@ -91,7 +91,7 @@ static int32_t converttoint(double_t);
 #endif
 
 /* Helps static branch prediction so hot path can be better optimized.  */
-#ifdef __GNUC__
+#if defined(__GNUC__) || defined(__clang__)
 #define predict_true(x) __builtin_expect(!!(x), 1)
 #define predict_false(x) __builtin_expect(x, 0)
 #else
