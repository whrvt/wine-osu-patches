         InitializeObjectAttributes(&attr, &eac_unix_name, 0, NULL, NULL);
 
-        if (!(status = nt_to_unix_file_name(&attr, &unix_path, FILE_OPEN)))
+        if (!(status = get_nt_and_unix_names(&attr, &eac_unix_name, &unix_path, FILE_OPEN)))
