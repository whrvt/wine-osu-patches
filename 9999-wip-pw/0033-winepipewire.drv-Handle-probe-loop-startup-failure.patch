From 984e905ab0ddf19ddc601503c73eb66031a5ddf4 Mon Sep 17 00:00:00 2001
From: M0n7y5 <17201053+M0n7y5@users.noreply.github.com>
Date: Mon, 6 Jul 2026 20:30:17 +0200
Subject: [PATCH 33/39] winepipewire.drv: Handle probe loop startup failure.

---
 dlls/winepipewire.drv/pipewire.c | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/dlls/winepipewire.drv/pipewire.c b/dlls/winepipewire.drv/pipewire.c
index dc841817458..1d62adb0fb6 100644
--- a/dlls/winepipewire.drv/pipewire.c
+++ b/dlls/winepipewire.drv/pipewire.c
@@ -1064,7 +1064,13 @@ static NTSTATUS pipewire_test_connect(void *args)
         return STATUS_SUCCESS;
     }
 
-    pw_thread_loop_start(p.loop);
+    if (pw_thread_loop_start(p.loop) < 0)
+    {
+        ERR("Failed to start PipeWire probe loop\n");
+        pw_context_destroy(p.context);
+        pw_thread_loop_destroy(p.loop);
+        return STATUS_SUCCESS;
+    }
     pw_thread_loop_lock(p.loop);
 
     if (!(p.core = pw_context_connect(p.context, NULL, 0)))
-- 
