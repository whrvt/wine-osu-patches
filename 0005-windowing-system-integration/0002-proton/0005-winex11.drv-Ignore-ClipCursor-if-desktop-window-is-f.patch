From d13ca7d92d456ef341db1064bf67124488f31be9 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?R=C3=A9mi=20Bernon?= <rbernon@codeweavers.com>
Date: Tue, 21 Jan 2020 21:05:05 +0100
Subject: [PATCH] winex11.drv: Ignore ClipCursor if desktop window is
 foreground.

CW-Bug-Id: #21879
---
 dlls/win32u/input.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/dlls/win32u/input.c b/dlls/win32u/input.c
index 9aed08b1a20..0afc439a3e3 100644
--- a/dlls/win32u/input.c
+++ b/dlls/win32u/input.c
@@ -2888,6 +2888,12 @@ BOOL WINAPI NtUserClipCursor( const RECT *rect )
 
     TRACE( "Clipping to %s\n", wine_dbgstr_rect(rect) );
 
+    if (NtUserGetForegroundWindow() == NtUserGetDesktopWindow())
+    {
+        WARN( "desktop is foreground, ignoring ClipCursor\n" );
+        rect = NULL;
+    }
+
     if (rect)
     {
         HWND foreground = NtUserGetForegroundWindow();
-- 
