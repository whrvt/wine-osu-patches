From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: NelloKudo <marshnelloosu@gmail.com>
Date: Wed, 26 Aug 2026 21:10:00 +0200
Subject: [PATCH 15/15] win32u: Enable EGL by default, keep it opt-in for
 winex11.

---
 dlls/win32u/opengl.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

--- a/dlls/win32u/opengl.c
+++ b/dlls/win32u/opengl.c
@@ -1422,7 +1422,7 @@
     struct opengl_funcs *funcs = &display_funcs;
     const char *extensions, *env;
 
-    if (!(env = getenv( "WINE_USE_EGL" )) || !atoi( env ))
+    if ((env = getenv( "WINE_USE_EGL" )) && !atoi( env ))
     {
         WARN( "EGL support is disabled.\n" );
         return FALSE;
-- 
