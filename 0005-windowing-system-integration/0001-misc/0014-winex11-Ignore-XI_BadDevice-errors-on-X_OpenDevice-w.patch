From a178ea8305a644c3ae93bdf4cd700bb31772416b Mon Sep 17 00:00:00 2001
From: William Horvath <william@horvath.blog>
Date: Sat, 8 Feb 2025 21:45:00 -0800
Subject: [PATCH 14/18] winex11: Ignore XI_BadDevice errors on X_OpenDevice
 when hotplugging devices.

---
 dlls/winex11.drv/x11drv_main.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/dlls/winex11.drv/x11drv_main.c b/dlls/winex11.drv/x11drv_main.c
index 9a31ce5c6f0..ee78782a841 100644
--- a/dlls/winex11.drv/x11drv_main.c
+++ b/dlls/winex11.drv/x11drv_main.c
@@ -231,6 +231,15 @@ static inline BOOL ignore_error( Display *display, XErrorEvent *event )
         }
 #endif
     }
+
+#ifdef HAVE_X11_EXTENSIONS_XINPUT_H
+    if (event->request_code == 131 /* XInputExtension */ &&
+        event->minor_code   == 3   /* X_OpenDevice */)
+    {
+        return TRUE;
+    }
+#endif
+
     return FALSE;
 }
 
