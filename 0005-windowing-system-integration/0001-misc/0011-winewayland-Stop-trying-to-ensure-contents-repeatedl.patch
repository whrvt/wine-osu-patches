From 31b8b66c3d2113189a56b99fa6b1de6857c9557f Mon Sep 17 00:00:00 2001
From: William Horvath <william@horvath.blog>
Date: Sat, 12 Oct 2024 14:44:05 -0700
Subject: [PATCH 11/18] winewayland: Stop trying to ensure contents repeatedly
 when it's not required for a surface.

Probably breaks stuff.
---
 dlls/winewayland.drv/waylanddrv.h | 1 +
 dlls/winewayland.drv/window.c     | 6 +++++-
 2 files changed, 6 insertions(+), 1 deletion(-)

diff --git a/dlls/winewayland.drv/waylanddrv.h b/dlls/winewayland.drv/waylanddrv.h
index 3b0c300a1f6..618eb485712 100644
--- a/dlls/winewayland.drv/waylanddrv.h
+++ b/dlls/winewayland.drv/waylanddrv.h
@@ -289,6 +289,7 @@ struct wayland_surface
     struct wayland_window_config window;
     int content_width, content_height;
     HCURSOR hcursor;
+    BOOL stop_ensuring_contents;
 };
 
 /**********************************************************************
diff --git a/dlls/winewayland.drv/window.c b/dlls/winewayland.drv/window.c
index 2c3d1f87408..bbf2aed0f13 100644
--- a/dlls/winewayland.drv/window.c
+++ b/dlls/winewayland.drv/window.c
@@ -857,7 +857,7 @@ void ensure_window_surface_contents(HWND hwnd)
 
     if (!(data = wayland_win_data_get(hwnd))) return;
 
-    if ((wayland_surface = data->wayland_surface))
+    if ((wayland_surface = data->wayland_surface) && !wayland_surface->stop_ensuring_contents)
     {
         wayland_surface_ensure_contents(wayland_surface);
 
@@ -869,6 +869,10 @@ void ensure_window_surface_contents(HWND hwnd)
         {
             wl_surface_commit(wayland_surface->wl_surface);
         }
+        else
+        {
+            wayland_surface->stop_ensuring_contents = TRUE;
+        }
     }
 
     wayland_win_data_release(data);
-- 
2.53.0

