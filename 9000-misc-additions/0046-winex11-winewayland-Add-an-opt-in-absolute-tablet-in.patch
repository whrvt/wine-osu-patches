From c8a69d343fc85823819a736dc6e03c2d49bb4be2 Mon Sep 17 00:00:00 2001
From: winebuild <wine@build.dev>
Date: Mon, 29 Jun 2026 23:10:31 +0200
Subject: [PATCH] winex11, winewayland: Add an opt-in absolute tablet input
 workaround.

Avoid pointer grabs, warps, and Wayland constraints that block absolute tablet input.
Enable with WINE_ABS_TABLET or WINE_ENABLE_ABS_TABLET_HACK.
---
 dlls/winewayland.drv/wayland_pointer.c | 14 ++++++++++++++
 dlls/winex11.drv/mouse.c               |  5 +++++
 dlls/winex11.drv/window.c              | 11 +++++++----
 dlls/winex11.drv/x11drv.h              |  2 ++
 dlls/winex11.drv/x11drv_main.c         |  5 +++++
 5 files changed, 33 insertions(+), 4 deletions(-)

diff --git a/dlls/winewayland.drv/wayland_pointer.c b/dlls/winewayland.drv/wayland_pointer.c
index 4b0a3322a4c..575ca6858f7 100644
--- a/dlls/winewayland.drv/wayland_pointer.c
+++ b/dlls/winewayland.drv/wayland_pointer.c
@@ -37,6 +37,16 @@
 
 WINE_DEFAULT_DEBUG_CHANNEL(cursor);
 
+static BOOL abs_tablet_hack_enabled(void)
+{
+    static int enabled = -1;
+
+    if (enabled == -1)
+        enabled = atoi( getenv( "WINE_ABS_TABLET" ) ?:
+                        getenv( "WINE_ENABLE_ABS_TABLET_HACK" ) ?: "0" ) != 0;
+    return enabled;
+}
+
 /* The cursor-shape-v1 protocol file references the zwp_tablet_tool_v2
  * interface object. Since we don't currently use the tablet protocol,
  * provide a dummy object here to avoid linking errors. */
@@ -1042,6 +1052,8 @@ static BOOL wayland_pointer_update_constraint(struct wl_surface *wl_surface,
     needs_confine = wl_surface && confine_rect && is_visible && !force_lock &&
                     pointer->wl_pointer;
 
+    if (abs_tablet_hack_enabled()) needs_lock = needs_confine = FALSE;
+
     if (!needs_confine && pointer->zwp_confined_pointer_v1)
     {
         TRACE("Unconfining from hwnd=%p\n", pointer->constraint_hwnd);
@@ -1169,6 +1181,8 @@ BOOL WAYLAND_SetCursorPos(INT x, INT y)
     struct wayland_pointer *pointer = &process_wayland.pointer;
     POINT pt = {.x = x, .y = y}, surface_pt;
 
+    if (abs_tablet_hack_enabled()) return TRUE;
+
     /* It doesn't make sense to warp a locked pointer, and
      * reapply_cursor_clippping may not lead to a pClipCursor under all conditions.
      * Therefore, we need pointer warp handling here but only when the pointer is not locked. */
diff --git a/dlls/winex11.drv/mouse.c b/dlls/winex11.drv/mouse.c
index c42c492707e..1be99e07a1b 100644
--- a/dlls/winex11.drv/mouse.c
+++ b/dlls/winex11.drv/mouse.c
@@ -479,6 +479,8 @@ static BOOL grab_clipping_window( const RECT *clip )
         pXISelectEvents( data->display, DefaultRootWindow( data->display ), &data->root_events, 1 );
     }
 
+    if (is_xwayland && abs_tablet_hack) return TRUE;
+
     TRACE( "clipping to %s win %lx\n", wine_dbgstr_rect(clip), clip_window );
 
     if (!data->clipping_cursor && clip_window_mapped) XUnmapWindow( data->display, clip_window );
@@ -1449,6 +1451,9 @@ BOOL X11DRV_SetCursorPos( INT x, INT y )
         return FALSE;
     }
 
+    /* warping the xwayland pointer can stop absolute tablet events */
+    if (is_xwayland && abs_tablet_hack) return TRUE;
+
     if (!clipping_cursor &&
         XGrabPointer( data->display, root_window, False,
                       PointerMotionMask | ButtonPressMask | ButtonReleaseMask,
diff --git a/dlls/winex11.drv/window.c b/dlls/winex11.drv/window.c
index 3ec077d779e..30468b90f79 100644
--- a/dlls/winex11.drv/window.c
+++ b/dlls/winex11.drv/window.c
@@ -3157,10 +3157,13 @@ void X11DRV_SetCapture( HWND hwnd, UINT flags, HWND previous )
         if (!(data = get_win_data( hwnd ))) return;
         if (data->whole_window)
         {
-            XGrabPointer( data->display, data->whole_window, False,
-                          PointerMotionMask | ButtonPressMask | ButtonReleaseMask,
-                          GrabModeAsync, GrabModeAsync, None, None, CurrentTime );
-            XFlush( data->display );
+            if (!(is_xwayland && abs_tablet_hack))
+            {
+                XGrabPointer( data->display, data->whole_window, False,
+                              PointerMotionMask | ButtonPressMask | ButtonReleaseMask,
+                              GrabModeAsync, GrabModeAsync, None, None, CurrentTime );
+                XFlush( data->display );
+            }
         }
         release_win_data( data );
     }
diff --git a/dlls/winex11.drv/x11drv.h b/dlls/winex11.drv/x11drv.h
index 3789d9cecda..d90af633d31 100644
--- a/dlls/winex11.drv/x11drv.h
+++ b/dlls/winex11.drv/x11drv.h
@@ -480,6 +480,8 @@ extern XPixmapFormatValues **pixmap_formats;
 extern Window root_window;
 extern BOOL clipping_cursor;
 extern BOOL keyboard_grabbed;
+extern BOOL is_xwayland;
+extern BOOL abs_tablet_hack;
 extern unsigned int screen_bpp;
 extern BOOL usexrandr;
 extern BOOL usexvidmode;
diff --git a/dlls/winex11.drv/x11drv_main.c b/dlls/winex11.drv/x11drv_main.c
index e341986050d..4fa645bb810 100644
--- a/dlls/winex11.drv/x11drv_main.c
+++ b/dlls/winex11.drv/x11drv_main.c
@@ -75,6 +75,8 @@ BOOL use_take_focus = TRUE;
 BOOL use_primary_selection = FALSE;
 BOOL use_system_cursors = TRUE;
 BOOL grab_fullscreen = FALSE;
+BOOL is_xwayland = FALSE;
+BOOL abs_tablet_hack = FALSE;
 BOOL managed_mode = TRUE;
 BOOL private_color_map = FALSE;
 int custom_fps = 0;
@@ -714,6 +716,9 @@ NTSTATUS __wine_unix_lib_init(void)
 #ifdef SONAME_LIBXCOMPOSITE
     X11DRV_XComposite_Init();
 #endif
+    is_xwayland = getenv( "WAYLAND_DISPLAY" ) != NULL;
+    abs_tablet_hack = atoi( getenv( "WINE_ABS_TABLET" ) ?:
+                            getenv( "WINE_ENABLE_ABS_TABLET_HACK" ) ?: "0" ) != 0;
     x11drv_xinput2_load();
 #ifdef HAVE_X11_EXTENSIONS_XINPUT_H
     x11drv_xinput_init( display );
-- 
2.56.0

