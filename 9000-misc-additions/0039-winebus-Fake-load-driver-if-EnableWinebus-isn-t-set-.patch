From 325646711dd564e5b5f9db560300ea79536cd21d Mon Sep 17 00:00:00 2001
From: William Horvath <william@horvath.blog>
Date: Sun, 8 Sep 2024 02:15:12 -0700
Subject: [PATCH] winebus: Fake-load driver if EnableWinebus isn't set to 1.

The registry key checked is a DWORD in HKLM\System\CurrentControlSet\Services\winebus.

This is just a simple method to disable winebus/hid/usb without ZwLoadDriver
complaining about not being able to load the driver.
---
 dlls/winebus.sys/main.c | 24 ++++++++++++++++++++----
 1 file changed, 20 insertions(+), 4 deletions(-)

diff --git a/dlls/winebus.sys/main.c b/dlls/winebus.sys/main.c
index 97ca2716309..f8b6007cd78 100644
--- a/dlls/winebus.sys/main.c
+++ b/dlls/winebus.sys/main.c
@@ -1746,10 +1746,25 @@ static void WINAPI driver_unload(DRIVER_OBJECT *driver)
     NtClose(driver_key);
 }
 
+static void WINAPI nop_unload(DRIVER_OBJECT *driver)
+{
+}
+
+static NTSTATUS WINAPI nop_dispatch(DEVICE_OBJECT *device, IRP *irp)
+{
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS WINAPI nop_add_device(DRIVER_OBJECT *driver, DEVICE_OBJECT *pdo)
+{
+    return STATUS_SUCCESS;
+}
+
 NTSTATUS WINAPI DriverEntry( DRIVER_OBJECT *driver, UNICODE_STRING *path )
 {
     OBJECT_ATTRIBUTES attr = {0};
     NTSTATUS ret;
+    DWORD on;
 
     TRACE( "(%p, %s)\n", driver, debugstr_w(path->Buffer) );
 
@@ -1763,10 +1778,11 @@ NTSTATUS WINAPI DriverEntry( DRIVER_OBJECT *driver, UNICODE_STRING *path )
 
     driver_obj = driver;
 
-    driver->MajorFunction[IRP_MJ_PNP] = common_pnp_dispatch;
-    driver->MajorFunction[IRP_MJ_INTERNAL_DEVICE_CONTROL] = hid_internal_dispatch;
-    driver->DriverExtension->AddDevice = driver_add_device;
-    driver->DriverUnload = driver_unload;
+    on = check_bus_option(L"EnableWinebus", FALSE);
+    driver->MajorFunction[IRP_MJ_PNP] = on ? common_pnp_dispatch : nop_dispatch;
+    driver->MajorFunction[IRP_MJ_INTERNAL_DEVICE_CONTROL] = on ? hid_internal_dispatch : nop_dispatch;
+    driver->DriverExtension->AddDevice = on ? driver_add_device : nop_add_device;
+    driver->DriverUnload = on ? driver_unload : nop_unload;
 
     return STATUS_SUCCESS;
 }
-- 
