From 1f84038d17daa229a833197e04f4b32c84efb5e7 Mon Sep 17 00:00:00 2001
From: NelloKudo <marshnelloosu@gmail.com>
Date: Sat, 18 Apr 2026 01:33:09 +0200
Subject: [PATCH] win32u: Add winstation cache.

---
 dlls/win32u/winstation.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/dlls/win32u/winstation.c b/dlls/win32u/winstation.c
index 3c55a80c5e1..2304db2b336 100644
--- a/dlls/win32u/winstation.c
+++ b/dlls/win32u/winstation.c
@@ -426,19 +426,25 @@ BOOL WINAPI NtUserCloseWindowStation( HWINSTA handle )
     return ret;
 }
 
+static HWINSTA winsta_cache = INVALID_HANDLE_VALUE;
+
 /***********************************************************************
  *           NtUSerGetProcessWindowStation  (win32u.@)
  */
 HWINSTA WINAPI NtUserGetProcessWindowStation(void)
 {
+    HWINSTA cache = winsta_cache;
     HWINSTA ret = 0;
 
+    if (cache != INVALID_HANDLE_VALUE) return cache;
+
     SERVER_START_REQ( get_process_winstation )
     {
         if (!wine_server_call_err( req ))
             ret = wine_server_ptr_handle( reply->handle );
     }
     SERVER_END_REQ;
+    winsta_cache = ret;
     return ret;
 }
 
@@ -449,6 +455,8 @@ BOOL WINAPI NtUserSetProcessWindowStation( HWINSTA handle )
 {
     BOOL ret;
 
+    winsta_cache = INVALID_HANDLE_VALUE;
+
     SERVER_START_REQ( set_process_winstation )
     {
         req->handle = wine_server_obj_handle( handle );
-- 
