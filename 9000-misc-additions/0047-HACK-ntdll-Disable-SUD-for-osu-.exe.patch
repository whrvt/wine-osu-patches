From ad9ce850f76cb98b9ef20cefed79982895d610fc Mon Sep 17 00:00:00 2001
From: NelloKudo <marshnelloosu@gmail.com>
Date: Mon, 31 Aug 2026 21:37:39 +0200
Subject: [PATCH] HACK: ntdll: Disable SUD for osu!.exe.

---
 dlls/ntdll/unix/signal_x86_64.c | 19 ++++++++++++++++++-
 1 file changed, 18 insertions(+), 1 deletion(-)

diff --git a/dlls/ntdll/unix/signal_x86_64.c b/dlls/ntdll/unix/signal_x86_64.c
index d7d19eb465a..9de321cc4b4 100644
--- a/dlls/ntdll/unix/signal_x86_64.c
+++ b/dlls/ntdll/unix/signal_x86_64.c
@@ -2174,6 +2174,22 @@ static BOOL handle_syscall_trap( struct thread_data *data, ucontext_t *sigcontex
 }
 
 
+/* osu!auth.dll makes native linux syscalls with int $0x80 from 32-bit code, and
+ * syscall user dispatch traps those and misdispatches them into the 64-bit dispatcher */
+static BOOL is_osu(void)
+{
+    int i;
+
+    for (i = 0; i < main_argc; i++)
+    {
+        if (strstr( main_argv[i], "osu!.exe" ))
+            return TRUE;
+    }    
+    
+    return FALSE;
+}
+
+
 /***********************************************************************
  *           check_invalid_gsbase
  *
@@ -2904,7 +2920,8 @@ __attribute__((used)) void init_syscall_frame( LPTHREAD_START_ROUTINE entry, voi
         arch_prctl( ARCH_GET_FS, &thread_data->pthread_teb );
         alloc_fs_sel( fs32_sel >> 3, get_wow_teb( teb ));
     }
-    if (syscall_dispatch_enabled && prctl( PR_SET_SYSCALL_USER_DISPATCH, PR_SYS_DISPATCH_ON,
+    if (syscall_dispatch_enabled && !is_osu() &&
+        prctl( PR_SET_SYSCALL_USER_DISPATCH, PR_SYS_DISPATCH_ON,
                                            libc_addr, libc_size, &thread_data->syscall_dispatch ) < 0)
         WARN_(seh)( "could not enable syscall user dispatch\n" );
 #elif defined (__FreeBSD__) || defined (__FreeBSD_kernel__)
-- 
