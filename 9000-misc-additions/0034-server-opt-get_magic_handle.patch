From: NelloKudo <marshnelloosu@gmail.com>
Date: Sat, 18 Apr 2026 01:26:03 +0200
Subject: [PATCH 34/47] server: opt-get_magic_handle

---
 server/handle.c | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/server/handle.c b/server/handle.c
index a51a794191c..2216599ff64 100644
--- a/server/handle.c
+++ b/server/handle.c
@@ -446,6 +446,13 @@ unsigned int close_handle( struct process *process, obj_handle_t handle )
 /* retrieve the object corresponding to one of the magic pseudo-handles */
 static inline struct object *get_magic_handle( obj_handle_t handle )
 {
+#ifdef __GNUC__
+    if (__builtin_expect(!(handle & 0xc0000000), 1))
+#else
+    if (!(handle & 0xc0000000))
+#endif
+        return NULL;
+
     switch(handle)
     {
         case 0xfffffffa:  /* current thread impersonation token pseudo-handle */
