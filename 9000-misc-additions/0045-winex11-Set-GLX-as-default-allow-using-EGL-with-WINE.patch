From 134fcec1f000488f8e9d7ce338140968b3b242b1 Mon Sep 17 00:00:00 2001
From: NelloKudo <marshnelloosu@gmail.com>
Date: Mon, 4 May 2026 18:18:50 +0200
Subject: [PATCH] winex11: Set GLX as default, allow using EGL with
 WINE_USE_EGL.

---
 dlls/winex11.drv/opengl.c      | 4 ++--
 dlls/winex11.drv/x11drv.h      | 1 +
 dlls/winex11.drv/x11drv_main.c | 7 +++++++
 3 files changed, 10 insertions(+), 2 deletions(-)

diff --git a/dlls/winex11.drv/opengl.c b/dlls/winex11.drv/opengl.c
index 171ac4026e2..673cb9f9ff0 100644
--- a/dlls/winex11.drv/opengl.c
+++ b/dlls/winex11.drv/opengl.c
@@ -478,7 +478,7 @@ static struct glx_pixel_format *glx_pixel_format_from_format( int format )
 
 BOOL visual_from_pixel_format( int format, XVisualInfo *visual )
 {
-    if (funcs->egl_handle)
+    if (use_egl && funcs->egl_handle)
     {
         EGLConfig config = egl_config_for_format( format );
         XVisualInfo *visuals;
@@ -566,7 +566,7 @@ UINT X11DRV_OpenGLInit( UINT version, const struct opengl_funcs *opengl_funcs, c
     }
     funcs = opengl_funcs;
 
-    if (opengl_funcs->egl_handle)
+    if (use_egl && opengl_funcs->egl_handle)
     {
         TRACE( "Using EGL OpenGL backend\n" );
         x11drv_driver_funcs = **driver_funcs;
diff --git a/dlls/winex11.drv/x11drv.h b/dlls/winex11.drv/x11drv.h
index c74fe9ff3a3..37e21902065 100644
--- a/dlls/winex11.drv/x11drv.h
+++ b/dlls/winex11.drv/x11drv.h
@@ -489,6 +489,7 @@ extern BOOL use_primary_selection;
 extern BOOL use_system_cursors;
 extern BOOL grab_fullscreen;
 extern BOOL usexcomposite;
+extern BOOL use_egl;
 extern BOOL managed_mode;
 extern BOOL private_color_map;
 extern int primary_monitor;
diff --git a/dlls/winex11.drv/x11drv_main.c b/dlls/winex11.drv/x11drv_main.c
index 2eef3ac7333..e341986050d 100644
--- a/dlls/winex11.drv/x11drv_main.c
+++ b/dlls/winex11.drv/x11drv_main.c
@@ -70,6 +70,7 @@ Window root_window;
 BOOL usexvidmode = TRUE;
 BOOL usexrandr = TRUE;
 BOOL usexcomposite = TRUE;
+BOOL use_egl = FALSE;
 BOOL use_take_focus = TRUE;
 BOOL use_primary_selection = FALSE;
 BOOL use_system_cursors = TRUE;
@@ -474,6 +475,12 @@ static void setup_options(void)
     if (!get_config_key( hkey, appkey, "Managed", buffer, sizeof(buffer) ))
         managed_mode = IS_OPTION_TRUE( buffer[0] );
 
+    if (!get_config_key( hkey, appkey, "UseEGL", buffer, sizeof(buffer) ))
+        use_egl = IS_OPTION_TRUE( buffer[0] );
+
+    if (getenv( "WINE_USE_EGL" ))
+        use_egl = IS_OPTION_TRUE( getenv( "WINE_USE_EGL" )[0] );
+
     if (!get_config_key( hkey, appkey, "UseXVidMode", buffer, sizeof(buffer) ))
         usexvidmode = IS_OPTION_TRUE( buffer[0] );
 
-- 
2.56.0

