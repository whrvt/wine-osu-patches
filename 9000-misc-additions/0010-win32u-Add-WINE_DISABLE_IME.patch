From 11eed935a322f0049c2c1cef34be6bbbe09acebe Mon Sep 17 00:00:00 2001
From: William Horvath <william@horvath.blog>
Date: Sat, 18 Apr 2026 01:17:43 +0200
Subject: [PATCH 10/46] win32u: Add WINE_DISABLE_IME.

---
 dlls/win32u/imm.c              | 3 ++-
 dlls/winex11.drv/x11drv_main.c | 3 ++-
 2 files changed, 4 insertions(+), 2 deletions(-)

diff --git a/dlls/win32u/imm.c b/dlls/win32u/imm.c
index f585b80a383..34cc0b7a693 100644
--- a/dlls/win32u/imm.c
+++ b/dlls/win32u/imm.c
@@ -290,7 +290,8 @@ BOOL register_imm_window( HWND hwnd )
 
     TRACE( "(%p)\n", hwnd );
 
-    if (disable_ime || !needs_ime_window( hwnd ))
+    const char *e = getenv("WINE_DISABLE_IME");
+    if ((e && *e != '\0' && *e != '0') || disable_ime || !needs_ime_window( hwnd ))
         return FALSE;
 
     thread_data = get_imm_thread_data();
diff --git a/dlls/winex11.drv/x11drv_main.c b/dlls/winex11.drv/x11drv_main.c
index 103ca12ae35..a4c587377ec 100644
--- a/dlls/winex11.drv/x11drv_main.c
+++ b/dlls/winex11.drv/x11drv_main.c
@@ -775,7 +775,8 @@ NTSTATUS __wine_unix_lib_init(void)
     XkbUseExtension( gdi_display, NULL, NULL );
     X11DRV_InitKeyboard( gdi_display );
     X11DRV_InitMouse( gdi_display );
-    if (use_xim) use_xim = xim_init( input_style );
+    const char *e = getenv("WINE_DISABLE_IME");
+    if (use_xim) use_xim = !(e && *e != '\0' && *e != '0') && xim_init( input_style );
     cursor_clip_hack = use_cursor_clip_hack();
 
     init_icm_profile();
-- 
2.53.0

