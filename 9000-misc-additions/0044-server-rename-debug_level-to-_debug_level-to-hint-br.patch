From 12704a8aee0a0cd5b3ab421c7b326cc876733bce Mon Sep 17 00:00:00 2001
From: NelloKudo <marshnelloosu@gmail.com>
Date: Sat, 18 Apr 2026 01:32:40 +0200
Subject: [PATCH 44/46] server: rename debug_level to _debug_level to hint
 branch predictor

---
 dlls/ntdll/unix/server.c | 2 +-
 server/main.c            | 6 +++---
 server/object.h          | 7 ++++++-
 server/protocol.def      | 2 +-
 server/thread.c          | 2 +-
 5 files changed, 12 insertions(+), 7 deletions(-)

diff --git a/dlls/ntdll/unix/server.c b/dlls/ntdll/unix/server.c
index b863c382eea..3ae9e86e61a 100644
--- a/dlls/ntdll/unix/server.c
+++ b/dlls/ntdll/unix/server.c
@@ -1729,7 +1729,7 @@ size_t server_init_process(void)
         req->unix_tid    = get_unix_tid();
         req->reply_fd    = reply_pipe;
         req->wait_fd     = data->wait_fd[1];
-        req->debug_level = (TRACE_ON(server) != 0);
+        req->_debug_level = (TRACE_ON(server) != 0);
         wine_server_set_reply( req, supported_machines, sizeof(supported_machines) );
         if (!(ret = wine_server_call( req )))
         {
diff --git a/server/main.c b/server/main.c
index 0827d61d41c..13da01930b1 100644
--- a/server/main.c
+++ b/server/main.c
@@ -44,7 +44,7 @@
 #include "fsync.h"
 
 /* command-line options */
-int debug_level = 0;
+int _debug_level = 0;
 int foreground = 0;
 timeout_t master_socket_timeout = 0; /* master socket timeout, default is 3 seconds */
 const char *server_argv0;
@@ -73,9 +73,9 @@ static void option_callback( int optc, char *optarg )
     {
     case 'd':
         if (optarg && isdigit(*optarg))
-            debug_level = atoi( optarg );
+            _debug_level = atoi( optarg );
         else
-            debug_level++;
+            _debug_level++;
         break;
     case 'f':
         foreground = 1;
diff --git a/server/object.h b/server/object.h
index 4b96a40e6c9..b832635ac9b 100644
--- a/server/object.h
+++ b/server/object.h
@@ -352,7 +352,12 @@ extern struct object *create_symlink( struct object *root, const struct unicode_
 /* global variables */
 
   /* command-line options */
-extern int debug_level;
+extern int _debug_level;
+#ifdef __GNUC__
+#define debug_level (__builtin_expect(_debug_level, 0))
+#else
+#define debug_level _debug_level
+#endif
 extern int foreground;
 extern timeout_t master_socket_timeout;
 extern const char *server_argv0;
diff --git a/server/protocol.def b/server/protocol.def
index da36c6f6a02..6499377e1ba 100644
--- a/server/protocol.def
+++ b/server/protocol.def
@@ -1152,7 +1152,7 @@ typedef volatile struct
 @REQ(init_first_thread)
     int          unix_pid;     /* Unix pid of new process */
     int          unix_tid;     /* Unix tid of new thread */
-    int          debug_level;  /* new debug level */
+    int          _debug_level;  /* new debug level */
     int          reply_fd;     /* fd for reply pipe */
     int          wait_fd;      /* fd for blocking calls pipe */
 @REPLY
diff --git a/server/thread.c b/server/thread.c
index 3cbbe6fd631..9e84b120a79 100644
--- a/server/thread.c
+++ b/server/thread.c
@@ -1810,7 +1810,7 @@ DECL_HANDLER(init_first_thread)
 
     set_thread_base_priority( current, current->base_priority );
 
-    debug_level = max( debug_level, req->debug_level );
+    _debug_level = max( debug_level, req->_debug_level );
 
     reply->pid          = get_process_id( process );
     reply->tid          = get_thread_id( current );
-- 
2.53.0

