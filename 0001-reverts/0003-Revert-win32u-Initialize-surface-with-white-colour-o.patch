From fe6f5b78b584ec1076abf97520e60fa230a25b1d Mon Sep 17 00:00:00 2001
From: NelloKudo <marshnelloosu@gmail.com>
Date: Wed, 24 Jun 2026 01:37:17 +0200
Subject: [PATCH] Revert "win32u: Initialize surface with white colour on
 creation."

This reverts commit 18339eb0f5048500efb668e6a9b679ed2f62d7a3.
---
 dlls/win32u/dce.c | 2 --
 1 file changed, 2 deletions(-)

diff --git a/dlls/win32u/dce.c b/dlls/win32u/dce.c
index 67d3dc84bc7..2e42bdb0f6e 100644
--- a/dlls/win32u/dce.c
+++ b/dlls/win32u/dce.c
@@ -576,8 +576,6 @@ struct window_surface *window_surface_create( const struct window_surface_funcs
 
     pthread_mutex_init( &surface->mutex, NULL );
 
-    memset( window_surface_get_color( surface, info ), 0xff, info->bmiHeader.biSizeImage );
-
     TRACE( "created surface %p for hwnd %p rect %s\n", surface, hwnd, wine_dbgstr_rect( &surface->rect ) );
     return surface;
 }
