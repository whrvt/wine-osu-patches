+static void xdg_activation_token_handle_done(void *user_data,
+                                             struct xdg_activation_token_v1 *token_object,
+                                             const char *token)
+{
+    struct wayland_win_data *data;
+    HWND hwnd = user_data;
+
+    if ((data = wayland_win_data_get(hwnd)))
+    {
+        if (data->wayland_surface)
+            xdg_activation_v1_activate(process_wayland.xdg_activation_v1, token,
+                                       data->wayland_surface->wl_surface);
+        wayland_win_data_release(data);
+    }
+    xdg_activation_token_v1_destroy(token_object);
+}
+
+static const struct xdg_activation_token_v1_listener xdg_activation_listener =
+{
+    xdg_activation_token_handle_done
