     struct wayland_win_data *data;
+    BOOL offscreen_changed = wayland_client_surface_update_offscreen(surface);
 
     if (!(data = wayland_win_data_get(hwnd))) return;
 
-    if (toplevel && NtUserIsWindowVisible(hwnd))
-        wayland_client_surface_attach(surface, toplevel);
-    else
-        wayland_client_surface_attach(surface, NULL);
+    if (data->client_surface != surface || offscreen_changed)
+    {
+        if (toplevel && !client->offscreen && NtUserIsWindowVisible(hwnd))
