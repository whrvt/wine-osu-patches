---
 dlls/winewayland.drv/wayland_pointer.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/dlls/winewayland.drv/wayland_pointer.c b/dlls/winewayland.drv/wayland_pointer.c
index 0faf2e33e5c..1729559d679 100644
--- a/dlls/winewayland.drv/wayland_pointer.c
+++ b/dlls/winewayland.drv/wayland_pointer.c
@@ -449,6 +449,7 @@ static void pointer_handle_axis_value120(void *data, struct wl_pointer *wl_point
     struct wayland_pointer_frame *frame = &pointer->frame;
     HWND hwnd;
 
+    if (!value120) return;
     if (!(hwnd = wayland_pointer_get_focused_hwnd())) return;
 
     pthread_mutex_lock(&pointer->mutex);
