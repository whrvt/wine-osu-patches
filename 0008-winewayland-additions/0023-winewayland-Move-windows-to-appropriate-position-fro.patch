+/***********************************************************************
+ *           WAYLAND_GetWindowStateUpdates
+ *
+ * Moves toplevel windows to the output the compositor placed them on, so
+ * that the win32 window position and monitor match the host placement.
+ */
+BOOL WAYLAND_GetWindowStateUpdates(HWND hwnd, UINT *state_cmd, UINT *swp_flags,
+                                   RECT *rect, HWND *foreground)
+{
+    DWORD style = NtUserGetWindowLongW(hwnd, GWL_STYLE);
+    struct surface_output_entry *output_entry;
+    struct wayland_surface *surface;
+    struct wayland_win_data *data;
+    BOOL ret = FALSE;
+
+    /* called again with NULL parameters to unlock the host state, nothing to do */
+    if (!state_cmd) return FALSE;
+
+    if (!(style & WS_VISIBLE)) return FALSE;
+    if ((style & (WS_POPUP | WS_CHILD)) == WS_CHILD) return FALSE;
+    if (style & (WS_DISABLED | WS_MINIMIZE)) return FALSE;
+
+    if (!(data = wayland_win_data_get(hwnd))) return FALSE;
+
+    if ((surface = data->wayland_surface) && wayland_surface_is_toplevel(surface) &&
+        !wl_list_empty(&surface->output_list) &&
+        /* the output hint syncs the win32u position to the toplevel position */
+        !(surface->window.state & WAYLAND_SURFACE_CONFIG_STATE_FULLSCREEN))
+    {
+        POINT origin;
+
+        output_entry = wl_container_of(surface->output_list.next, output_entry, entry);
+
+        pthread_mutex_lock(&process_wayland.output_mutex);
+        ret = wayland_output_get_origin(output_entry->output, &origin);
+        pthread_mutex_unlock(&process_wayland.output_mutex);
+
+        if (ret)
+        {
+            *swp_flags = SWP_NOSIZE | SWP_NOOWNERZORDER | SWP_NOZORDER | SWP_NOACTIVATE;
+            SetRect(rect, origin.x, origin.y, origin.x + 1, origin.y + 1);
+            TRACE("Moving hwnd=%p to %s\n", hwnd, wine_dbgstr_rect(rect));
+        }
+    }
+
+    wayland_win_data_release(data);
+    return ret;
+}
+
