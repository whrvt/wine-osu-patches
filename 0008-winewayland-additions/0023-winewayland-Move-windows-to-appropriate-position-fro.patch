+/* Get the position of an output in the win32 (raw) virtual screen.
+ * Locking is done externally, output_mutex must be held. */
+BOOL wayland_output_get_origin(struct wayland_output *output, POINT *origin)
+{
+    struct wl_array output_info_array;
+    struct output_info *output_info;
+    BOOL found = FALSE;
+
+    wl_array_init(&output_info_array);
+    output_info_array_init(&output_info_array);
+
+    wl_array_for_each(output_info, &output_info_array)
+    {
+        if (output_info->output != &output->current) continue;
+        origin->x = output_info->x;
+        origin->y = output_info->y;
+        found = TRUE;
+        break;
+    }
+
+    wl_array_release(&output_info_array);
+    return found;
+}
+
