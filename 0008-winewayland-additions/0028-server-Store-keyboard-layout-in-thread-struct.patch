+    thread->context         = NULL;
+    thread->teb             = 0;
+    thread->entry_point     = 0;
+    thread->system_regs     = 0;
+    thread->queue           = NULL;
+    thread->wait            = NULL;
+    thread->error           = 0;
+    thread->req_data        = NULL;
+    thread->req_toread      = 0;
+    thread->reply_data      = NULL;
+    thread->reply_towrite   = 0;
+    thread->request_fd      = NULL;
+    thread->reply_fd        = NULL;
+    thread->wait_fd         = NULL;
+    thread->state           = RUNNING;
+    thread->exit_code       = 0;
