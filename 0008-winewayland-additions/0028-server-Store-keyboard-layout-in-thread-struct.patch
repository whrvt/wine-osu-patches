+        int              __pad;
+        client_ptr_t     file;      /* opaque ptr for the file object */
+    } volume;
+    struct
+    {
+        enum irp_type    type;      /* IRP_CALL_FREE */
+        int              __pad;
+        client_ptr_t     obj;       /* opaque ptr for the freed object */
+    } free;
+    struct
+    {
+        enum irp_type    type;      /* IRP_CALL_CANCEL */
