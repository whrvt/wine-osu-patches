From 6a97f041b2e54bec3834ee6f98c4f61c00e9415a Mon Sep 17 00:00:00 2001
From: Torge Matthies <tmatthies@codeweavers.com>
Date: Thu, 14 Sep 2023 23:32:18 +0200
Subject: [PATCH 46/51] server: Set O_NOATIME on pipes.

Signed-off-by: Torge Matthies <tmatthies@codeweavers.com>
---
 server/signal.c | 9 +++++++++
 server/thread.c | 9 +++++++++
 2 files changed, 18 insertions(+)

diff --git a/server/signal.c b/server/signal.c
index 078951af6e4..ae8571ff00a 100644
--- a/server/signal.c
+++ b/server/signal.c
@@ -20,6 +20,7 @@
 
 #include "config.h"
 
+#include <fcntl.h>
 #include <signal.h>
 #include <stdio.h>
 #include <sys/time.h>
@@ -40,6 +41,10 @@
 # define SIG_PTHREAD_CANCEL (__SIGRTMIN+1)
 #endif
 
+#ifndef O_NOATIME
+#define O_NOATIME 0x40000
+#endif
+
 typedef void (*signal_callback)(void);
 
 struct handler
@@ -113,6 +118,10 @@ static struct handler *create_handler( signal_callback callback )
         close( fd[1] );
         return NULL;
     }
+#ifdef __linux__
+    fcntl( fd[0], F_SETFL, O_NOATIME );
+    fcntl( fd[1], F_SETFL, O_NOATIME );
+#endif
     handler->pipe_write = fd[1];
     handler->pending    = 0;
     handler->callback   = callback;
diff --git a/server/thread.c b/server/thread.c
index b995bd04cb2..694a2ca3884 100644
--- a/server/thread.c
+++ b/server/thread.c
@@ -63,6 +63,11 @@
 #include "fsync.h"
 
 
+#ifndef O_NOATIME
+#define O_NOATIME 0x40000
+#endif
+
+
 /* thread queues */
 
 struct thread_wait
@@ -516,6 +521,10 @@ struct thread *create_thread( int fd, struct process *process, const struct secu
             file_set_error();
             return NULL;
         }
+#ifdef __linux__
+        fcntl( request_pipe[0], F_SETFL, O_NOATIME );
+        fcntl( request_pipe[1], F_SETFL, O_NOATIME );
+#endif
         if (send_client_fd( process, request_pipe[1], SERVER_PROTOCOL_VERSION ) == -1)
         {
             close( request_pipe[0] );
-- 
2.53.0

