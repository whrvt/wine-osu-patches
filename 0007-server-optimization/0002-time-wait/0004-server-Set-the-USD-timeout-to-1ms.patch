From 68a4caaa3e9e8b7d687f399576ad38db502af91c Mon Sep 17 00:00:00 2001
From: William Horvath <william@horvath.blog>
Date: Sun, 23 Feb 2025 20:17:51 -0800
Subject: [PATCH 4/5] server: Set the USD timeout to 1ms.

Games almost unconditionally set a 1ms timer period anyways.
---
 server/fd.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/server/fd.c b/server/fd.c
index 0345055fb1a..9ebbd2b2a4a 100644
--- a/server/fd.c
+++ b/server/fd.c
@@ -352,7 +352,7 @@ timeout_t current_time;
 timeout_t monotonic_time;
 
 struct _KUSER_SHARED_DATA *user_shared_data = NULL;
-static const timeout_t user_shared_data_timeout = 16 * 10000;
+static const timeout_t user_shared_data_timeout = 1 * 10000;
 
 static void atomic_store_ulong(volatile ULONG *ptr, ULONG value)
 {
